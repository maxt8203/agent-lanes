{
  "permissions": {
    "allow": [
      "Bash(./crew:*)",
      "Bash({{PY}} coord/agentctl.py:*)"
    ],
    "deny": [
      "Bash(./crew start:*)",
      "Edit(./coord/owners.json)",
      "Edit(./coord/approvals.json)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "{{PY}} \"$CLAUDE_PROJECT_DIR/coord/agentctl.py\" hook session" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "{{PY}} \"$CLAUDE_PROJECT_DIR/coord/agentctl.py\" hook inbox" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "{{PY}} \"$CLAUDE_PROJECT_DIR/coord/agentctl.py\" hook owner" }
        ]
      }
    ]
  }
}
